# OpenRouter API key. Leave unset to run the chat in mock mode.
OPENROUTER_API_KEY=

# OpenRouter model ID (see openrouter.ai/models). Optional.
CHAT_MODEL=

# Upstash Redis for rate limiting. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max chat requests per day across all visitors. Optional, default 500.
CHAT_DAILY_LIMIT=
